{
	"schemaVersion": 1,
	"id": "dmxlighting",
	"version": "${version}",
	"name": "dmxLighting",
	"description": "Adds DMX-addressable theatrical fixtures, emissive pixel blocks, and an in-game lighting console for Ableton Live-driven Minecraft performances.",
	"authors": [
		"AutumnAteEverything"
	],
	"license": "CC0-1.0",
	"icon": "assets/dmxlighting/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dmx.lighting.DmxLighting"
		],
		"client": [
			"dmx.lighting.client.DmxLightingClient"
		]
	},
	"mixins": [
		"dmxlighting.mixins.json",
		{
			"config": "dmxlighting.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}
